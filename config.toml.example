# Reqall MCP server configuration for Codex.
# Copy into your Codex config.toml and set REQALL_API_KEY in the environment.
# Native OAuth is preferred when available:
#   codex mcp add reqall --url https://www.reqall.net/mcp
#   codex mcp login reqall

# Example:
#   export REQALL_API_KEY="..."

[mcp_servers.reqall]
# Cloud default. For self-hosted Reqall, replace this URL.
url = "https://www.reqall.net/mcp"
bearer_token_env_var = "REQALL_API_KEY"
